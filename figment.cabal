cabal-version:      2.4
name:               figment
version:            0.1.0.0
synopsis:           Layered configuration merging with per-node provenance
description:
  Core merge algebra, depth-bounded tagging, and closed error vocabulary
  for the Figment configuration library. See ENGINEERING_STANDARD.md and
  the feasibility study for the governing design.
license:            BSD-3-Clause
author:             (TBD)
maintainer:         (TBD)
category:           Configuration
build-type:         Simple
tested-with:        GHC == 9.10.3 || == 9.12.4
extra-doc-files:    ENGINEERING_STANDARD.md
                    ADRs/001-defaultDepth-64.md

common warnings
  -- §5.1: mandatory compiler flags. Applied to every component, not
  -- opt-in per module (§6 setup checklist).
  ghc-options:
    -Wall -Wcompat
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wmissing-export-lists -Wunused-imports -Wunused-top-binds
    -Wunused-local-binds -Wunused-matches
    -Wredundant-constraints -Wpartial-fields -Widentities
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    ScopedTypeVariables
    DeriveGeneric
    DeriveAnyClass
    LambdaCase
    CPP

flag dev
  description: Enable -Werror for local development
  default:     False
  manual:      True

library
  import:             warnings
  if flag(dev)
    ghc-options: -Werror
  hs-source-dirs:     src
  exposed-modules:
    Figment.Prim
    Figment.Value
    Figment.Merge
    Figment.Layer
    Figment.Error
    Figment.Provider
    Figment.Check
    Figment.Extract
    Figment.Prov
    Figment.Provider.Json
    Figment.Provider.Env
    Figment.Provider.Cli
    Figment.Provider.Defaults
    Figment.Provider.Toml
    Figment.Provider.Yaml
    Figment
  build-depends:
      base        >= 4.17 && < 5
    , containers  >= 0.6.7 && < 0.8
    , deepseq     >= 1.4.8 && < 1.6
    , aeson       >= 2.1   && < 2.4
    , bytestring  >= 0.11  && < 0.13
    , vector      >= 0.13  && < 0.14
    , scientific  >= 0.3.7 && < 0.4
    , text        >= 2.0.2 && < 2.2
    , toml-parser >= 2.0   && < 2.1
    , yaml        >= 0.11  && < 0.12

test-suite figment-test
  import:             warnings
  if flag(dev)
    ghc-options: -Werror
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  other-modules:
    Figment.Properties
    Figment.Arbitrary
    Figment.ExtractTests
    Figment.JsonProvider
    Figment.EnvProvider
    Figment.CliProvider
    Figment.Precision
    Figment.Compose
    Figment.RequiredFields
    Figment.Adversarial
    Figment.GoldenErrors
    Figment.ParserFuzz
    Figment.SafeBoundary
    Figment.SafeBoundaryTest
    Figment.Stress
    Figment.Model
    Figment.FileProviders
    Figment.ProvTests
  build-depends:
      base
    , figment
    , containers
    , scientific
    , text
    , QuickCheck  >= 2.14.3 && < 2.20
    , tasty       >= 1.4   && < 1.6
    , tasty-quickcheck
    , tasty-hedgehog
    , hedgehog
    , tasty-hunit
    , tasty-golden
    , temporary
    , filepath
    , aeson
    , bytestring
  build-tool-depends: cabal-install:cabal
  ghc-options:        -threaded -rtsopts "-with-rtsopts=-N -M256m -K4m"

benchmark figment-bench
  import:             warnings
  if flag(dev)
    ghc-options: -Werror
  type:               exitcode-stdio-1.0
  hs-source-dirs:     bench
  main-is:            Bench.hs
  other-modules:
    Figment.Bench
  build-depends:
      base
    , figment
    , text
    , criterion  >= 1.6 && < 1.8
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
